{
  "name": "botparty",
  "version": "0.1.3",
  "private": true,
  "description": "BotParty – Real-time robot teleoperation platform",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "docs:api-client": "node scripts/generate-api-client-docs.mjs",
    "generate:ts-api-client": "node scripts/generate-ts-api-client.mjs",
    "openapi:export": "pnpm --filter @botparty/api build && node apps/api/dist/openapi/export-openapi.js docs/openapi.json",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:build:api": "docker compose build api",
    "docker:build:web": "docker compose build web",
    "docker:build:app": "docker compose build api web nginx",
    "docker:build:infra": "docker compose build postgres redis livekit livekit-ingress livekit-egress cadvisor",
    "docker:up:core": "docker compose up -d postgres redis livekit livekit-ingress livekit-egress cadvisor",
    "docker:up:app": "docker compose up -d api web nginx",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:verify-migrations": "node scripts/verify-prisma-migrations.mjs",
    "env:check": "node scripts/check-env-parity.mjs",
    "architecture:check": "node scripts/check-web-module-size.mjs",
    "secrets:smoke": "./scripts/smoke-file-secrets.sh",
    "dev:smoke": "./scripts/smoke-dev-compose.sh",
    "backup:release": "./scripts/backup-release.sh",
    "restore:drill": "./scripts/restore-drill.sh",
    "benchmark:queue": "pnpm --filter @botparty/prisma exec tsx ../../scripts/benchmark-queue.ts",
    "web:budget": "pnpm --filter @botparty/web performance:budget",
    "db:studio": "pnpm --filter @botparty/prisma db:studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@botparty/eslint-config": "workspace:*",
    "@botparty/tsconfig": "workspace:*",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "1.14.4",
      "defu": "6.1.7",
      "effect": "3.22.0",
      "fast-uri": "3.1.2",
      "fast-xml-builder": "1.3.0",
      "lodash": "4.18.1",
      "path-to-regexp": "8.4.2",
      "protobufjs@<8": "7.6.1",
      "protobufjs@>=8": "8.7.1"
    }
  }
}
