# Generated from this template by setup-env.sh → docker/nginx/nginx.ssl.conf (gitignored).
# DO NOT edit nginx.ssl.conf directly — edit this template and re-run setup-env.sh.
#
# Placeholder:  __DOMAIN__  → replaced with your domain by setup-env.sh

worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # ─── Logging ─────────────────────────────────────
    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'rt=$request_time upstream="$upstream_addr" '
                    'upstream_status="$upstream_status" urt="$upstream_response_time"';

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # ─── Performance ─────────────────────────────────
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    # Recycle persistently busy HTTP keep-alive connections so clients leave
    # gracefully retired workers and receive the current Docker-DNS peer set.
    # Upgraded WebSocket connections use their dedicated locations/timeouts.
    keepalive_time 10s;
    keepalive_requests 100;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    resolver 127.0.0.11 valid=1s ipv6=off;
    # Bound connection setup so a removed container address does not retain a
    # browser request for nginx's 60-second default timeout.
    proxy_connect_timeout 2s;
    proxy_next_upstream error timeout invalid_header http_502 http_504;
    proxy_next_upstream_tries 3;

    # ─── Rate Limiting ───────────────────────────────
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=auth_login:10m rate=3r/m;
    limit_req_zone $binary_remote_addr zone=auth_sensitive:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=csp_report:10m rate=10r/m;
    limit_conn_zone $binary_remote_addr zone=health_conn:1m;
    limit_req_status 429;
    limit_conn_status 429;

    # ─── Upstreams ───────────────────────────────────
    upstream web {
        zone web 64k;
        include /tmp/nginx-upstreams/web.conf;
    }

    upstream api {
        zone api_backend 64k;
        include /tmp/nginx-upstreams/api.conf;
    }

    upstream livekit {
        zone livekit 64k;
        server livekit:7880 resolve;
    }

    upstream livekit_ingress {
        zone livekit_ingress 64k;
        server livekit-ingress:8080 resolve;
    }

    upstream minio {
        zone minio 64k;
        server minio:9000 resolve;
    }

    # ─── HTTP → HTTPS redirect ───────────────────────
    server {
        listen 80;
        server_name __DOMAIN__;

        location = /api/v1/health/live {
            proxy_pass http://api;
            proxy_set_header Host $host;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ─── HTTPS ───────────────────────────────────────
    server {
        listen 443 ssl;
        http2 on;
        server_name __DOMAIN__;

        error_page 429 = @rate_limited;

        location @rate_limited {
            internal;
            default_type application/json;
            add_header Retry-After 1 always;
            return 429 '{"statusCode":429,"message":"Too many requests"}';
        }

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        location = /api/v1/health/live {
            limit_conn health_conn 32;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /api/v1/health/ready {
            limit_conn health_conn 32;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # ─── API ─────────────────────────────────────
        location /api/ {
            limit_req zone=api burst=60 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # ─── Auth login (extra-strict per-IP throttle) ──
        location = /api/v1/auth/login {
            limit_req zone=auth_login burst=5 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location ~ ^/api/v1/auth/(register|forgot-password|reset-password)$ {
            limit_req zone=auth_sensitive burst=5 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location ~ ^/api/v1/billing/webhooks/(stripe|paypal)$ {
            client_max_body_size 256k;
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /api/v1/health/csp-report {
            client_max_body_size 16k;
            limit_req zone=csp_report burst=5 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # ─── Auth endpoints (stricter rate limit) ────
        location /api/v1/auth/ {
            limit_req zone=auth burst=30 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # ─── WebSocket ──────────────────────────────
        location /ws {
            proxy_pass http://api;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 86400;
        }

        # ─── LiveKit Signaling / API ───────────────────────────
        location /rtc {
            proxy_pass http://livekit;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 86400;
        }

        location /twirp/ {
            proxy_pass http://livekit;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /storage/ {
            return 403;
        }

        location = /whip {
            return 308 /whip/;
        }

        location /whip/ {
            proxy_pass http://livekit_ingress;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 86400;
        }

        # ─── Swagger Docs ───────────────────────────
        location /api-docs {
            proxy_pass http://api;
            proxy_set_header Host $host;
        }

        # ─── Frontend (catch-all) ───────────────────
        # Current replicas return their instance marker for rollout admission.
        # The compatibility response keeps a rollback to the immediately
        # preceding release healthy when that image has no dedicated Web probe.
        location = /web-health/live {
            proxy_pass http://web;
            proxy_intercept_errors on;
            error_page 404 = @legacy_web_health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location @legacy_web_health {
            default_type application/json;
            return 200 '{"status":"ok","compatibility":"legacy"}';
        }

        location / {
            proxy_pass http://web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
