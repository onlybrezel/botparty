{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "PUBLIC_DEPLOYMENT",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_LIVEKIT_URL",
    "NEXT_PUBLIC_LEGAL_OPERATOR_NAME",
    "NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL",
    "NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS",
    "NEXT_PUBLIC_LEGAL_OPERATOR_COUNTRY",
    "NEXT_PUBLIC_LEGAL_GOVERNING_LAW",
    "NEXT_PUBLIC_LEGAL_VAT_ID",
    "NEXT_PUBLIC_LEGAL_COMMERCIAL_REGISTER",
    "NEXT_PUBLIC_LEGAL_SUPPORT_URL",
    "NEXT_PUBLIC_IMAGE_REMOTE_HOSTS",
    "NEXT_PUBLIC_FEATURE_BILLING",
    "NEXT_PUBLIC_FEATURE_DONATIONS",
    "NEXT_PUBLIC_FEATURE_PAYOUTS",
    "NEXT_PUBLIC_FEATURE_PAID_CONTROLS",
    "NEXT_PUBLIC_APP_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
