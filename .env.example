# ─── General ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Optional file-backed secret inputs for Docker/Kubernetes secret mounts.
# If both VAR and VAR_FILE are present, the direct VAR wins.
# DATABASE_URL_FILE=
# REDIS_PASSWORD_FILE=
# JWT_SECRET_FILE=
# JWT_REFRESH_SECRET_FILE=
# LIVEKIT_API_SECRET_FILE=
# SMTP_PASSWORD_FILE=
# SEED_ADMIN_PASSWORD_FILE=
# SEED_DEMO_USER_PASSWORD_FILE=

# ─── Database ─────────────────────────────────────────
# DB_PASSWORD is used by docker-compose for the postgres container and DATABASE_URL
# connection_limit: tune based on your server's CPU count (default Prisma pool = num_cpus * 2 + 1)
DB_PASSWORD=botparty_secret
# For external PostgreSQL (non-Docker), append ?sslmode=require to encrypt traffic.
# Inside Docker Compose the API and postgres share an internal network — sslmode=disable is acceptable there.
DATABASE_URL=postgresql://botparty:botparty_secret@localhost:5432/botparty?schema=public&connection_limit=10&pool_timeout=30&sslmode=disable

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=botparty_redis_secret

# ─── JWT / Auth ───────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_min_32_chars_long!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_min_32_chars!!
JWT_REFRESH_EXPIRES_IN=7d

# ─── LiveKit ──────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_that_is_at_least_32_characters_long
LIVEKIT_URL=ws://localhost:7880
# Public LiveKit URL exposed to browsers (used in production behind nginx/TLS)
LIVEKIT_PUBLIC_URL=wss://your-domain.com/rtc
# Directory inside the API container where recordings are stored
LIVEKIT_RECORDINGS_DIR=/recordings
LIVEKIT_RECORDING_FILEPATH_TEMPLATE=/out/{room_name}-{time}.mp4
# Optional: output template for room recordings (used by admin recording controls)
# Override if you use S3/GCS egress upload instead of local file output.

# ─── Runtime Metrics ───────────────────────────────────
# cAdvisor is started by docker-compose and exposes container/host metrics for the mod dashboard.
CADVISOR_URL=http://cadvisor:8080

# ─── App URL ──────────────────────────────────────────
# Public-facing app URL (used in email links, etc.)
APP_URL=http://localhost:3000

# ─── SMTP ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BotParty <no-reply@example.com>

# ─── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── API Docs ─────────────────────────────────────
# Set SWAGGER_DOCS=true to expose /api/docs in production (default: off)
# SWAGGER_DOCS=false

# ─── Log Aggregation / Error Tracking ─────────────
# Uncomment and set your Sentry DSN to enable error reporting.
# Both API and Web can use Sentry (install @sentry/nestjs and @sentry/nextjs).
# SENTRY_DSN=https://your-dsn@sentry.io/0
# SENTRY_ENVIRONMENT=production

# ─── Seeding ──────────────────────────────────────────
# Required when bootstrapping an empty production database.
SEED_ADMIN_PASSWORD=change-this-admin-password
# Optional demo user for non-production environments.
SEED_DEMO_USER_PASSWORD=change-this-user-password

# ─── nginx ────────────────────────────────────────────
# For HTTPS production: set to ./docker/nginx/nginx.ssl.conf (generated by setup-env.sh)
# For local dev: leave as ./docker/nginx/nginx.conf (the default)
NGINX_CONF=./docker/nginx/nginx.conf
