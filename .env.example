# ─── General ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────
# DB_PASSWORD is used by docker-compose for the postgres container and DATABASE_URL
DB_PASSWORD=botparty_secret
DATABASE_URL=postgresql://botparty:botparty_secret@localhost:5432/botparty?schema=public

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=botparty_redis_secret

# ─── JWT / Auth ───────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_min_32_chars_long!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_min_32_chars!!
JWT_REFRESH_EXPIRES_IN=7d

# ─── LiveKit ──────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_that_is_at_least_32_characters_long
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_RECORDING_FILEPATH_TEMPLATE=/out/{room_name}-{time}.mp4
# Optional: output template for room recordings (used by admin recording controls)
# Override if you use S3/GCS egress upload instead of local file output.

# ─── Runtime Metrics ───────────────────────────────────
# cAdvisor is started by docker-compose and exposes container/host metrics for the mod dashboard.
CADVISOR_URL=http://cadvisor:8080

# ─── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Seeding ──────────────────────────────────────────
# Required when bootstrapping an empty production database.
SEED_ADMIN_PASSWORD=change-this-admin-password
# Optional demo user for non-production environments.
SEED_DEMO_USER_PASSWORD=change-this-user-password

# ─── nginx ────────────────────────────────────────────
# For HTTPS production: set to ./docker/nginx/nginx.ssl.conf (generated by setup-env.sh)
# For local dev: leave as ./docker/nginx/nginx.conf (the default)
NGINX_CONF=./docker/nginx/nginx.conf
