# ─── General ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Optional file-backed secret inputs for Docker/Kubernetes secret mounts.
# If both VAR and VAR_FILE are present, the direct VAR wins.
# DATABASE_URL_FILE=
# REDIS_PASSWORD_FILE=
# JWT_SECRET_FILE=
# JWT_REFRESH_SECRET_FILE=
# WEBHOOK_SECRET_ENCRYPTION_KEY_FILE=
# LIVEKIT_API_SECRET_FILE=
# SMTP_PASSWORD_FILE=
# SEED_ADMIN_PASSWORD_FILE=
# SEED_DEMO_USER_PASSWORD_FILE=

# ─── Database ─────────────────────────────────────────
# DB_PASSWORD is used by docker-compose for the postgres container and DATABASE_URL
# connection_limit: tune based on your server's CPU count (default Prisma pool = num_cpus * 2 + 1)
DB_PASSWORD=
# For external PostgreSQL (non-Docker), append ?sslmode=require to encrypt traffic.
# Inside Docker Compose the API and postgres share an internal network — sslmode=disable is acceptable there.
DATABASE_URL=postgresql://botparty:<set-db-password>@localhost:5432/botparty?schema=public&connection_limit=10&pool_timeout=30&sslmode=disable

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT / Auth ───────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
ROBOT_JWT_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Require users to verify their email address before they can receive login sessions.
REQUIRE_EMAIL_VERIFICATION=false
ROBOT_CLAIM_TOKEN_MAX_AGE_DAYS=90
# Required in production for encrypting stored outbound webhook secrets.
WEBHOOK_SECRET_ENCRYPTION_KEY=
ROBOT_STREAM_KEY_MAX_AGE_DAYS=90
MAX_ROBOTS_PER_OWNER=25
MAX_WEBHOOKS_PER_ROBOT=10
MAX_EXTERNAL_CAMERAS_PER_ROBOT=6
MAX_ACTIVE_QUEUE_ENTRIES_PER_USER=5

# ─── LiveKit ──────────────────────────────────────────
# IMPORTANT: Do NOT use 'devkey' in production. Boot will fail with that value.
# Generate with: `openssl rand -hex 16`
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
# Public LiveKit URL exposed to browsers (used in production behind nginx/TLS)
LIVEKIT_PUBLIC_URL=wss://your-domain.com/rtc
LIVEKIT_RECORDING_OBJECT_KEY_TEMPLATE={room_name}-{time}.mp4
LIVEKIT_RECORDINGS_S3_BUCKET=botparty-recordings
LIVEKIT_RECORDINGS_S3_REGION=us-east-1
LIVEKIT_RECORDINGS_S3_ENDPOINT=http://minio:9000
LIVEKIT_RECORDINGS_S3_ACCESS_KEY_ID=botpartyminio
LIVEKIT_RECORDINGS_S3_SECRET_ACCESS_KEY=change-this-minio-password
LIVEKIT_RECORDINGS_S3_FORCE_PATH_STYLE=true
RECORDING_SIGNED_URL_TTL_SEC=300
# Automatically expire recording objects after this many days (set to 0 to disable).
RECORDING_RETENTION_DAYS=30

# ─── Runtime Metrics ───────────────────────────────────
# cAdvisor is started by docker-compose and exposes container/host metrics for the mod dashboard.
CADVISOR_URL=http://cadvisor:8080
# Protect /api/v1/health/metrics with HTTP basic auth. Enabled by default in production.
METRICS_AUTH_REQUIRED=false
METRICS_USERNAME=metrics
METRICS_PASSWORD=
# Automatically prune admin audit log entries older than this many days (set to 0 to disable).
ADMIN_AUDIT_LOG_RETENTION_DAYS=180
# Reconciliation sweep for grouped ledger entries (set to 0 to disable).
LEDGER_RECONCILIATION_LOOKBACK_DAYS=30

# ─── App URL ──────────────────────────────────────────
# Public-facing app URL (used in email links, etc.)
APP_URL=http://localhost:3000

# ─── SMTP ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BotParty <no-reply@example.com>

# ─── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to bump the service worker script URL on every deploy/tag.
NEXT_PUBLIC_APP_VERSION=dev
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_OPERATOR_COUNTRY=Germany
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=Germany
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_COMMERCIAL_REGISTER=
NEXT_PUBLIC_LEGAL_SUPPORT_URL=

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── MinIO / Object Storage ──────────────────────────
MINIO_ROOT_USER=botpartyminio
MINIO_ROOT_PASSWORD=change-this-minio-password

# ─── Thumbnail Storage ───────────────────────────────
THUMBNAIL_PUBLIC_BASE_URL=http://localhost:3000/storage/botparty-thumbnails
THUMBNAIL_S3_BUCKET=botparty-thumbnails
THUMBNAIL_S3_REGION=us-east-1
THUMBNAIL_S3_ENDPOINT=http://minio:9000
THUMBNAIL_S3_ACCESS_KEY_ID=botpartyminio
THUMBNAIL_S3_SECRET_ACCESS_KEY=change-this-minio-password
THUMBNAIL_S3_FORCE_PATH_STYLE=true

# ─── API Docs ─────────────────────────────────────
# Set SWAGGER_DOCS=true to expose /api/docs in production (default: off)
# SWAGGER_DOCS=false
# When enabling Swagger in production, also set basic auth credentials.
# SWAGGER_DOCS_USERNAME=docs
# SWAGGER_DOCS_PASSWORD=change-this-swagger-password

# ─── Log Aggregation / Error Tracking ─────────────
# Uncomment and set your Sentry DSN to enable error reporting.
# Both API and Web can use Sentry (install @sentry/nestjs and @sentry/nextjs).
# SENTRY_DSN=https://your-dsn@sentry.io/0
# SENTRY_ENVIRONMENT=production

# ─── Seeding ──────────────────────────────────────────
# Required when bootstrapping an empty production database.
SEED_ADMIN_PASSWORD=change-this-admin-password
# Optional demo user for non-production environments.
SEED_DEMO_USER_PASSWORD=change-this-user-password

# ─── nginx ────────────────────────────────────────────
# For HTTPS production: set to ./docker/nginx/nginx.ssl.conf (generated by setup-env.sh)
# For local dev: leave as ./docker/nginx/nginx.conf (the default)
NGINX_CONF=./docker/nginx/nginx.conf

# ─── Billing — Stripe (optional) ─────────────────────
# Setting STRIPE_SECRET_KEY enables the Stripe provider; STRIPE_WEBHOOK_SECRET
# becomes mandatory and is enforced at boot.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ─── Billing — PayPal (optional) ─────────────────────
# Setting PAYPAL_CLIENT_ID enables the PayPal provider; the secret and webhook
# id then become mandatory.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_ENV=sandbox          # or 'live'

# ─── Fastify / Networking ────────────────────────────
# Body limit for HTTP requests. Default 5 MiB.
# FASTIFY_BODY_LIMIT=5242880
# Trust-proxy header parsing. Defaults to private/loopback ranges.
# Set to a comma-separated list of trusted proxy CIDRs in production
# (e.g. the docker bridge network of nginx).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ─── Auth — Password Reset ───────────────────────────
# TTL of password reset tokens in seconds. Default 3600 (1 h).
# PASSWORD_RESET_TTL_SEC=3600

# ─── Image / Asset Hosts (CSP & next/image) ──────────
# Comma-separated list of additional origins that may serve images via next/image
# and are added to the CSP connect-src list. Examples:
#   NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=https://cdn.example.com,https://thumbs.example.com
# CSP_EXTRA_CONNECT_ORIGINS=
# CSP_EXTRA_IMG_ORIGINS=
