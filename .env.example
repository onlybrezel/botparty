# ─── General ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://botparty:botparty_secret@localhost:5432/botparty?schema=public

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=botparty_redis_secret

# ─── JWT / Auth ───────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_min_32_chars_long!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_min_32_chars!!
JWT_REFRESH_EXPIRES_IN=7d

# ─── LiveKit ──────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_that_is_at_least_32_characters_long
LIVEKIT_URL=ws://localhost:7880

# ─── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
