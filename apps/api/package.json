{
  "name": "@botparty/api",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @botparty/shared build && rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "dev": "rm -rf dist tsconfig.tsbuildinfo && nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles && node ../../scripts/check-critical-api-coverage.mjs",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/openapi/**",
      "!**/types/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 55,
        "branches": 40,
        "functions": 50,
        "lines": 55
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@botparty/prisma$": "<rootDir>/../node_modules/@botparty/prisma",
      "^@botparty/shared$": "<rootDir>/../node_modules/@botparty/shared"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@botparty/prisma": "workspace:*",
    "@botparty/shared": "workspace:*",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "10.1.3",
    "@livekit/protocol": "^1.50.4",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.28",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/instrumentation": "7.9.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.11.2",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "^2.17.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@botparty/eslint-config": "workspace:*",
    "@botparty/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.5.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3"
  }
}
