{
  "name": "@botparty/web",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node ../../scripts/validate-public-env.mjs && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "performance:budget": "node ../../scripts/check-web-budgets.mjs",
    "performance:lighthouse": "node ../../scripts/run-lighthouse.mjs",
    "typecheck": "rm -rf .next && next typegen && tsc --noEmit",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@botparty/shared": "workspace:*",
    "@livekit/components-react": "^2.9.23",
    "@tailwindcss/postcss": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.20.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@botparty/eslint-config": "workspace:*",
    "@botparty/tsconfig": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "^15.5.18",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.10",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
